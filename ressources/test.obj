# Cube simple en format OBJ
# 8 Vertices (Sommets)
v -1.0 -1.0  1.0
v  1.0 -1.0  1.0
v  1.0  1.0  1.0
v -1.0  1.0  1.0
v -1.0 -1.0 -1.0
v  1.0 -1.0 -1.0
v  1.0  1.0 -1.0
v -1.0  1.0 -1.0

# 6 Faces (Définies par l'index de leurs sommets)
f 1//1 2//1 3//1 4//1
f 2//1 6//1 7//1 3//1
f 6//1 5//1 8//1 7//1
f 5//1 1//1 4//1 8//1
f 4//1 3//1 7//1 8//1
f 5//1 6//1 2//1 1//1